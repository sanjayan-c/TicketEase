<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cus_purple">

    <ImageView
        android:id="@+id/cusTransportationTimeTableBack"
        android:layout_width="62dp"
        android:layout_height="54dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="34dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="661dp"
        android:scaleType="fitXY"
        android:src="@drawable/cus_img_backarrow"
        tools:ignore="ContentDescription" />


    <RelativeLayout
        android:id="@+id/cusAccManagementHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="10dp">


        <TextView
            style="@style/custxtOpenSansromanbold20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="TicketEase"
            android:textColor="@color/white"
            android:textSize="25dp" />
    </RelativeLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearCard"
        android:layout_width="350dp"
        android:layout_height="231dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        android:background="@drawable/cus_purple">

        <TextView
            android:id="@+id/cusAccBal"
            android:layout_width="109dp"
            android:layout_height="21dp"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="104dp"
            android:text="@string/lbl_passenger_count"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/cusAccBal6"
            android:layout_width="109dp"
            android:layout_height="21dp"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="68dp"
            android:text="Started Time"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/cusAccBal5"
            android:layout_width="109dp"
            android:layout_height="21dp"
            android:layout_marginStart="172dp"
            android:layout_marginBottom="104dp"
            android:text="@string/lbl_passenger_count"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/TripStartTime"
            android:layout_width="109dp"
            android:layout_height="21dp"
            android:layout_marginStart="172dp"
            android:layout_marginBottom="68dp"
            android:text="Started Time"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/cusAccBal3"
            android:layout_width="109dp"
            android:layout_height="21dp"
            android:layout_marginStart="36dp"
            android:layout_marginBottom="144dp"
            android:text="@string/lbl_vehicle_no"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView

            android:layout_width="109dp"
            android:layout_height="21dp"
            android:layout_marginStart="172dp"
            android:layout_marginBottom="144dp"
            android:text="@string/lbl_vehicle_no"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/linearCustomerHomeDetails"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="335dp"
        android:orientation="vertical">

    </LinearLayout>

    <LinearLayout
        android:layout_width="380dp"
        android:layout_height="93dp"
        android:layout_below="@+id/linearCard"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="78dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="229dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ins_qr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/cus_purple1"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="start"
                android:layout_marginEnd="8dp"
                android:src="@drawable/cus_qr" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:paddingStart="10dp"
                android:text="QR Code"
                android:textColor="@color/white"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/endbutton"
        android:layout_width="152dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="124dp"
        android:layout_marginEnd="135dp"
        android:layout_marginBottom="93dp"
        android:text="End Trip" />


</RelativeLayout>