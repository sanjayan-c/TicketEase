<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CustomerVirtualWallet"
    android:background="@drawable/cus_purple">

    <RelativeLayout
        android:id="@+id/cusVirtualWalletHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">

        <ImageView
            android:id="@+id/cusVirtualWalletBack"
            android:layout_height="40dp"
            android:layout_width="40dp"
            android:scaleType="fitXY"
            tools:ignore="ContentDescription"
            android:src="@drawable/cus_img_backarrow" />

        <TextView
            style="@style/custxtOpenSansromanbold20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Virtual Wallet"
            android:textColor="@color/white"
            android:textSize="25dp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_marginBottom="30dp"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="50dp"
        android:layout_below="@+id/cusVirtualWalletHeading">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout android:gravity="start"
                android:id="@+id/cusVirtualWalletBalance"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="vertical"
                style="@style/cusgroupStylecornerRadius_1">

                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="15dp"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/custxtOpenSansHebrewbold24"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="0.5"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="My Balance"
                        android:textSize="20sp" />
                    <TextView
                        android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="70dp"
                        android:layout_weight="0.5"
                        android:layout_width="0dp"
                        android:padding="10dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:text="Wallet"
                        style="@style/custxtSolidRounded_1"/>
                </LinearLayout>

                <LinearLayout android:gravity="start"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:orientation="horizontal">
                    <LinearLayout android:gravity="start"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:layout_width="0dp" android:orientation="vertical">
                        <LinearLayout android:gravity="start"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_width="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:ellipsize="end"
                                android:id="@+id/cusVirtualWalletBalanceText"
                                android:layout_height="wrap_content"
                                android:layout_width="match_parent"
                                android:singleLine="true"
                                android:textSize="24sp"
                                style="@style/custxtOpenSansHebrewbold32"/>
                            <TextView android:ellipsize="end"
                                android:layout_marginStart="5dp"
                                android:layout_height="wrap_content"
                                android:layout_width="wrap_content"
                                android:singleLine="true"
                                android:text="LKR"
                                style="@style/custxtOpenSansHebrewbold16_1"/>
                        </LinearLayout>
                        <LinearLayout android:gravity="start"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_marginBottom="10dp"
                            android:layout_marginTop="10dp"
                            android:layout_width="wrap_content"
                            android:orientation="vertical"
                            style="@style/cusgroupStylegray_900cornerRadius">
                            <TextView android:ellipsize="end"
                                android:gravity="center_vertical"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="10dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="10dp"
                                android:layout_width="wrap_content"
                                android:singleLine="true"
                                android:text="Virtual Card Number"
                                style="@style/custxtOpenSansHebrewregular15"/>
                            <TextView android:ellipsize="end"
                                android:gravity="center_vertical"
                                android:id="@+id/cusVirtualWalletCardNo"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                android:layout_marginEnd="10dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="5dp"
                                android:layout_width="wrap_content"
                                android:singleLine="true"
                                android:text="LC4596XXXXXXXXXXXXXXXXX"
                                style="@style/custxtOpenSansHebrewbold15" />
                        </LinearLayout>
                    </LinearLayout>
                    <ImageView android:id="@+id/imageGroup"
                        android:layout_height="50dp"
                        android:layout_width="50dp"
                        android:layout_gravity="center_vertical"
                        android:scaleType="fitXY"
                        android:src="@drawable/cus_my_wallet_img_group"
                        tools:ignore="ContentDescription"/>
                </LinearLayout>
                <TextView android:ellipsize="end"
                    android:id="@+id/cusVirtualWalletTimeLastUpdate"
                    android:layout_gravity="end"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp"
                    android:layout_marginHorizontal="15dp"
                    android:layout_width="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="5dp"
                    android:singleLine="true"
                    style="@style/custxtSolidRounded_2" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/cusWalletProgressBarLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/cusVirtualWalletTransMethods"
                android:layout_centerInParent="true"
                android:background="#80000000">

                <ProgressBar
                    android:id="@+id/cusWalletProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_centerInParent="true" />
            </FrameLayout>


            <LinearLayout
                android:id="@+id/cusVirtualWalletTransMethods"
                android:gravity="center_vertical"
                android:layout_below="@+id/cusVirtualWalletBalance"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:layout_width="match_parent"
                android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/cusVirtualWalletTopUp"
                    android:layout_gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:layout_weight="0.5"
                    android:orientation="vertical"
                    style="@style/cusgroupStyle_2">
                    <ImageView
                        android:id="@+id/cusVirtualWalletTopUpImage"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:scaleType="fitXY"
                        android:src="@drawable/cus_my_wallet_topup"
                        tools:ignore="ContentDescription"/>
                    <TextView android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:singleLine="true"
                        android:text="Top Up"
                        style="@style/custxtOpenSansHebrewbold15"/>
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/white" />
                <LinearLayout
                    android:id="@+id/cusVirtualWalletTransactions"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:layout_weight="0.5"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    style="@style/cusgroupStyle_2">
                    <ImageView
                        android:id="@+id/cusVirtualWalletTransactionsImage"
                        android:layout_gravity="center_horizontal"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:scaleType="fitXY"
                        android:src="@drawable/cus_my_wallet_transactions_selected"
                        tools:ignore="ContentDescription"/>
                    <TextView android:ellipsize="end"
                        android:id="@+id/txtTransactions"
                        android:layout_gravity="center_horizontal"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:singleLine="true"
                        android:text="Transactions"
                        style="@style/custxtOpenSansHebrewbold15"/>
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/white" />
                <LinearLayout
                    android:id="@+id/cusVirtualPendingTransactions"
                    android:layout_gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_width="0dp"
                    android:layout_weight="0.5"
                    android:orientation="vertical"
                    style="@style/cusgroupStyle_2">
                    <ImageView
                        android:id="@+id/cusVirtualPendingTransactionsImage"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:scaleType="fitXY"
                        android:src="@drawable/cus_my_wallet_pendings"
                        tools:ignore="ContentDescription"/>
                    <TextView android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:singleLine="true"
                        android:text="Pendings"
                        style="@style/custxtOpenSansHebrewbold15"/>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/cusTransactionMethodFragmentContainer"
                android:layout_below="@+id/cusVirtualWalletTransMethods"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp" />
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>